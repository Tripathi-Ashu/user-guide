{
  "website": {
    "name": "GovCon360",
    "startUrl": "https://asponte-stg.nlproducts.net"
  },
  "auth": {
    "enabled": true,
    "loginUrl": "https://asponte-stg.nlproducts.net/",
    "usernameSelector": "#username",
    "passwordSelector": "#password",
    "submitSelector": "#kc-login",
    "successUrl": "https://asponte-stg.nlproducts.net/**"
  },
  "browser": {
    "headless": true,
    "width": 1440,
    "height": 900
  },
  "crawler": {
    "waitTime": 1500,
    "delayBetweenPages": 500,
    "timeout": 90000,
    "loadingTimeout": 15000,
    "navigationRetries": 3,
    "waitUntil": "load",
    "loadingSelector": ".skeleton, [class*=\"skeleton\"], [aria-busy=\"true\"], [role=\"progressbar\"]",
    "sameDomainOnly": true,
    "removeQueryParameters": true,
    "excludeUrlPatterns": [
      "logout",
      "log-out",
      "signout",
      "sign-out",
      "logoff"
    ]
  },
  "output": {
    "folder": "output",
    "saveIndividualJson": true,
    "saveScreenshots": true,
    "saveSummary": true,
    "fullPageScreenshot": true
  }
}